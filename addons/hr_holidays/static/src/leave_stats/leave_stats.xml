<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <div t-name="hr_holidays.LeaveStatsComponent" class="o_leave_stats">
        <div t-if="this.state.employee and this.state.leaves.length !== 0" id="o_leave_stats_employee" class="sub_table px-3 py-2 mb-3">
            <div>
                <h4 class="d-flex">
                    Summary (<t t-out="thisYear"/>)
                </h4>
            </div>
            <div class="d-flex flex-column mb-1">
                <div t-foreach="state.leaves" t-as="record_leave" t-key="record_leave.data.id" class="d-flex mb-2 gap-1">
                    <ColorPickerField name="'color'" canToggle="false" readonly="true" record="record_leave"/>
                    <t t-set="leave" t-value="record_leave.data"/>
                    <span class="col-3" t-out="leave.work_entry_type_id.display_name"/>
                    <div class="col-3 flex-wrap">
                        <span t-if="leave.work_entry_type_request_unit == 'hour'"><t t-out="leave.number_of_hours"/> hours</span>
                        <span t-else=""><t t-out="leave.number_of_days"/> days</span>
                    </div>
                    <div>
                    </div>
                </div>
            </div>
        </div>
        <div t-if="state.department and state.nbEmployee > 0" id="o_leave_stats_department" class="px-3 py-2 alert alert-info">
            <div>
                <h4>
                    <t t-out="state.department_name"/>
                    Overlaps
                </h4>
            </div>
            <div>
                <b t-out="state.nbEmployee"/>
                team members on holiday during this period
                <a class="oe_link fw-bold"
                    href="#"
                    t-on-click="action_department_leaves"
                    icon="oi-arrow-right">
                    <i class="oi oi-fw o_button_icon oi-arrow-right"/>
                    View Overlaps
                </a>
            </div>
        </div>
    </div>
</templates>
