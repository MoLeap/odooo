<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_self_order.PresetInfoPopup">
        <Dialog header="false"
            contentClass="'h-50 w-100 m-0 position-absolute self_order_pills_selection_popup_dialog'"
            bodyClass="'p-4 pb-3 m-0'"
            title="this.props.title">
            <div class="select_popup_preset_info w-100 d-flex flex-column h-100 overflow-hidden">
                <div class="d-flex justify-content-between align-items-center px-2 mt-2 mb-4">
                    <h2 class="mb-0">We need more info</h2>
                    <button class="btn-close" aria-label="close" t-on-click="this.close"/>
                </div>
                <div class="d-flex flex-column gap-3 overflow-y-auto overflow-x-hidden flex-grow-1">
                    <select t-if="this.preset.needsPartner and this.existingPartners.length"
                        class="partner-select form-select form-select-lg"
                        t-on-change="this.selectExistingPartner"
                        t-custom-model="state.selectedPartnerId">
                        <option value="">
                            Select your address
                        </option>
                        <t t-foreach="this.existingPartners" t-as="partner" t-key="partner.id">
                            <option t-att-value="partner.id" t-out="partner.name + ' ' + partner.address" />
                        </t>
                    </select>
                    <input t-if="this.preset.needsName || this.preset.needsPartner"
                        type="text"
                        class="form-control form-control-lg"
                        t-att-placeholder="this.partnerIsSelected ? '*************' : 'Name'"
                        t-custom-model="state.name"
                        t-att-disabled="this.partnerIsSelected" />
                    <input t-if="this.preset.needsEmail || this.preset.needsPartner"
                        type="text"
                        class="form-control form-control-lg"
                        t-att-placeholder="this.partnerIsSelected ? '*************' : 'Email'"
                        t-custom-model="state.email"
                        t-att-disabled="this.partnerIsSelected" />
                    <div t-if="this.preset.needsName || this.preset.needsPartner" class="input-group input-group-lg">
                        <!-- Country prefix picker: transparent select overlays a styled display div -->
                        <div class="position-relative" style="max-width: 25%; min-width: 90px">
                            <div class="form-select h-100 d-flex align-items-center gap-1 pe-none user-select-none">
                                <t t-if="selectedCountry">
                                    <t t-out="flagEmoji(selectedCountry.code)"/>
                                    <span>+<t t-out="selectedCountry.phone_code"/></span>
                                </t>
                            </div>
                            <select class="position-absolute top-0 start-0 w-100 h-100 opacity-0"
                                style="cursor: pointer"
                                t-model.number="state.phoneCountryId"
                                t-att-disabled="this.partnerIsSelected">
                                <option t-foreach="this.allCountries" t-as="c" t-key="c.id"
                                    t-att-value="c.id">
                                    <t t-out="flagEmoji(c.code)"/> +<t t-out="c.phone_code"/> <t t-out="c.name"/>
                                </option>
                            </select>
                        </div>
                        <input type="tel"
                            class="form-control"
                            placeholder="Phone number"
                            t-model="state.phoneLocal"
                            t-att-disabled="this.partnerIsSelected"/>
                    </div>
                    <p t-if="!this.checkPhoneFormat()" class="text-danger">Enter a valid phone number</p>
                    <t t-if="this.preset.needsPartner">
                        <select class="partner-select form-select form-select-lg" t-custom-model="state.countryId" t-att-disabled="this.partnerIsSelected">
                            <option value="">
                                <t t-if="this.partnerIsSelected">*************</t>
                                <t t-else="">Select a country</t>
                            </option>
                            <t t-foreach="this.countries" t-as="country" t-key="country.id">
                                <option t-att-value="country.id" t-out="country.name" />
                            </t>
                        </select>
                        <div class="d-flex gap-3">
                            <input type="text"
                                class="form-control form-control-lg w-75"
                                t-att-placeholder="this.partnerIsSelected ? '*************' : 'Street and Number'"
                                t-custom-model="state.street"
                                t-att-disabled="this.partnerIsSelected"/>
                            <input
                                type="text"
                                class="form-control form-control-lg w-25"
                                t-att-placeholder="this.partnerIsSelected ? '*************' : 'Zip'"
                                t-custom-model="state.zip"
                                t-att-disabled="this.partnerIsSelected"/>
                        </div>
                        <div class="d-flex gap-3">
                            <t t-set="availableState" t-value="this.states" />
                            <select t-if="availableState.length" class="partner-select form-select form-select-lg" t-custom-model="state.stateId" t-att-disabled="this.partnerIsSelected">
                                <option value="">
                                    <t t-if="this.partnerIsSelected">*************</t>
                                    <t t-else="">Select a state</t>
                                </option>
                                <t t-foreach="availableState" t-as="state" t-key="state.id">
                                    <option t-att-value="state.id" t-out="state.name" />
                                </t>
                            </select>
                            <input type="text"
                                class="form-control form-control-lg"
                                t-att-placeholder="this.partnerIsSelected ? '*************' : 'City'"
                                t-custom-model="state.city"
                                t-att-disabled="this.partnerIsSelected"/>
                        </div>
                    </t>
                </div>
                <div class="w-100 d-flex mt-3">
                    <button class="btn btn-secondary flex-grow-1 me-1"
                        t-on-click="this.props.close">
                        Cancel
                    </button>
                    <button class="btn btn-primary flex-grow-1 ms-1"
                        t-on-click="this.setInformations"
                        t-att-disabled="!this.validSelection">
                        Continue
                    </button>
                </div>
            </div>
        </Dialog>
    </t>
</templates>
