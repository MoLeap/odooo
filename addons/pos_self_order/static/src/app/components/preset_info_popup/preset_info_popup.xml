<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_self_order.PresetInfoPopup">
        <Dialog header="false"
            contentClass="'w-100 m-0 position-absolute self_order_pills_selection_popup_dialog'"
            bodyClass="'p-4 pb-3 m-0'"
            title="this.props.title">
            <div class="select_popup_preset_info w-100 d-flex flex-column h-100 overflow-hidden">
                <div class="d-flex justify-content-between align-items-center px-2 mt-2 mb-4">
                    <h2 class="mb-0">We need more info</h2>
                    <button class="btn-close" aria-label="close" t-on-click="this.close"/>
                </div>
                <div class="d-flex flex-column gap-3 overflow-y-auto overflow-x-hidden flex-grow-1 pb-2">
                    <select t-if="preset.needsPartner and existingPartners.length"
                        class="partner-select form-select form-select-lg"
                        t-on-change="this.selectExistingPartner"
                        t-custom-model="state.selectedPartnerId">
                        <option value="">
                            Select your address
                        </option>
                        <t t-foreach="existingPartners" t-as="partner" t-key="partner.id">
                            <option t-att-value="partner.id" t-out="partner.name + (partner.street ? ' - ' + partner.street : '')" />
                        </t>
                    </select>
                    <input t-if="this.preset.needsName || this.preset.needsPartner"
                        type="text"
                        class="form-control form-control-lg"
                        t-att-placeholder="this.partnerIsSelected ? '*************' : 'Name'"
                        t-custom-model="state.name"
                        t-att-disabled="this.partnerIsSelected" />
                    <input t-if="this.preset.needsEmail || this.preset.needsPartner"
                        type="text"
                        class="form-control form-control-lg"
                        t-att-placeholder="this.partnerIsSelected ? '*************' : 'Email'"
                        t-custom-model="state.email"
                        t-att-disabled="partnerIsSelected" />
                    <div t-if="preset.needsName || preset.needsPartner" class="input-group input-group-lg">
                        <!-- Country prefix picker: transparent select overlays a styled display div -->
                        <div class="position-relative" style="max-width: 25%; min-width: 90px">
                            <div class="form-select h-100 d-flex align-items-center gap-1 pe-none user-select-none">
                                <t t-if="selectedCountry">
                                    <t t-out="flagEmoji(selectedCountry.code)"/>
                                    <span>+<t t-out="selectedCountry.phone_code"/></span>
                                </t>
                            </div>
                            <select class="position-absolute top-0 start-0 w-100 h-100 opacity-0"
                                style="cursor: pointer"
                                t-model.number="state.phoneCountryId"
                                t-att-disabled="this.partnerIsSelected">
                                <option t-foreach="this.allCountries" t-as="c" t-key="c.id"
                                    t-att-value="c.id">
                                    <t t-out="flagEmoji(c.code)"/> +<t t-out="c.phone_code"/> <t t-out="c.name"/>
                                </option>
                            </select>
                        </div>
                        <input type="tel"
                            class="form-control"
                            placeholder="Phone number"
                            t-model="state.phoneLocal"
                            t-att-disabled="partnerIsSelected"/>
                    </div>
                    <p t-if="!checkPhoneFormat()" class="text-danger">Enter a valid phone number</p>
                    <t t-if="preset.needsPartner">
                        <div t-att-class="'o_field_widget o_field_google_address_autocomplete' + (state.validationError?.type === 'delivery' ? ' address-delivery-error' : '')">
                            <AddressAutoComplete t-props="addressAutoCompleteProps" />
                            <div class="d-flex justify-content-end mt-1">
                                <img src="/google_address_autocomplete/static/src/img/powered_by_google_on_white.png"
                                    alt="Powered by Google"
                                    style="height: 18px;"/>
                            </div>
                        </div>
                        <t t-if="state.validationError">
                            <p class="text-danger mb-0" t-esc="state.validationError.message"/>
                            <div t-if="state.validationError.type === 'delivery' and availablePresets.length" class="d-flex gap-2 flex-wrap justify-content-center">
                                <button t-foreach="availablePresets" t-as="altPreset" t-key="altPreset.id"
                                    type="button"
                                    class="btn btn-light btn-sm"
                                    t-on-click="() => this.selectPreset(altPreset)"
                                    t-out="altPreset.name"
                                />
                            </div>
                        </t>
                    </t>
                </div>
                <div class="w-100 d-flex mt-3">
                    <button class="btn btn-secondary flex-grow-1 me-1"
                        t-on-click="this.props.close">
                        Cancel
                    </button>
                    <button class="btn btn-primary flex-grow-1 ms-1"
                        t-on-click="setInformations"
                        t-att-disabled="!this.validSelection || state.isSubmitting">
                        <t t-if="state.isSubmitting">
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true" />
                            Validating...
                        </t>
                        <t t-else="">
                            Continue
                        </t>
                    </button>
                </div>
            </div>
        </Dialog>
    </t>
</templates>
