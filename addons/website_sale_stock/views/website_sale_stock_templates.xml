<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template
        id="website_sale_stock.website_sale_stock_cart_lines"
        inherit_id="website_sale.cart_lines_quantity"
        name="Shopping Cart Lines"
    >
        <xpath expr="//input[@type='text'][hasclass('quantity')]" position="attributes">
            <attribute name="t-att-data-max">line._get_max_line_qty()</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'css_quantity')]" position="after">
            <div class="availability_messages"/>
        </xpath>
    </template>

    <template
        id="website_sale_stock.website_sale_stock_product"
        inherit_id="website_sale.cta_wrapper"
    >
        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="before">
            <div class="availability_messages o_not_editable"/>
            <input id="wsale_user_email" type="hidden" t-att-value="user_email"/>
        </xpath>

        <xpath expr="//div[@id='add_to_cart_wrap']" position="after">
            <t t-set="is_storable" t-value="combination_info.get('is_storable')"/>
            <t t-set="prevent_sale" t-value="combination_info.get('prevent_sale')"/>

            <div
                id="out_of_stock_buttons_wrapper"
                t-attf-class="d-none flex-grow-1 flex-lg-grow-0 flex-wrap align-items-center gap-2 {{'' if is_50_pc else 'w-100'}}"
            >
                <button
                    id="product_stock_notification_message"
                    t-attf-class="d-none btn btn-primary flex-grow-1"
                    data-animation-selector=".o_wsale_product_images"
                    t-att-data-product-id="product.id"
                    invisible="not is_storable or prevent_sale"
                >
                    <i class="fa fa-envelope-o me-2"/>
                    Notify me
                </button>
                <button
                    id="stock_notification_success_message"
                    t-attf-class="d-none btn btn-outline-primary flex-grow-1"
                    data-animation-selector=".o_wsale_product_images"
                    invisible="not is_storable or prevent_sale"
                    disabled=""
                >
                    <i class="fa fa-bell me-2"/>
                    Subscribed
                </button>
            </div>
        </xpath>

        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="after">
            <t t-set="stock_notification_email" t-value="combination_info.get('stock_notification_email')"/>
            <div
                id="stock_notification_div_wrapper"
                t-attf-class="d-none flex-grow-1 flex-lg-grow-0 flex-wrap align-items-center mb-4 {{'' if is_50_pc else 'w-100'}}"
            >
                <div id="stock_notification_form" class="flex-grow-1">
                    <div id="stock_notification_input_wrapper" class="input-group">
                        <input
                            class="form-control flex-grow-1"
                            id="stock_notification_input"
                            name="email"
                            type="text"
                            placeholder="youremail@gmail.com"
                            t-att-value="stock_notification_email if stock_notification_email else ''"
                        />
                        <button
                            id="product_stock_notification_form_submit_button"
                            class="btn btn-primary"
                            t-att-data-product-id="product.id"
                        >
                            Subscribe
                        </button>
                    </div>
                    <div id="stock_notification_input_incorrect" class="d-none form-text text-danger">
                        Invalid email
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template
        id="website_sale_stock.cta_wrapper_boxed"
        inherit_id="website_sale.cta_wrapper_boxed"
        name="Bordered CTA Wrapper"
    >
        <xpath expr="//div[@id='out_of_stock_buttons_wrapper']" position="attributes">
            <attribute name="t-attf-class" remove="flex-lg-grow-0" separator=" "/>
        </xpath>

        <xpath expr="//div[@id='stock_notification_div_wrapper']" position="attributes">
            <attribute name="t-attf-class" remove="flex-lg-grow-0 mb-4" separator=" "/>
        </xpath>

        <xpath expr="//div[@id='out_of_stock_buttons_wrapper']" position="after">
            <xpath expr="//div[@id='stock_notification_div_wrapper']" position="move"/>
        </xpath>
    </template>

    <template
        id="website_sale_stock.cta_wrapper_large"
        inherit_id="website_sale.cta_wrapper_large"
        name="Large CTA Wrapper">
        <xpath expr="//div[@id='out_of_stock_buttons_wrapper']" position="attributes">
            <attribute name="t-attf-class" remove="flex-lg-grow-0" separator=" "/>
        </xpath>

        <xpath expr="//div[@id='stock_notification_div_wrapper']" position="attributes">
            <attribute name="t-attf-class" remove="flex-lg-grow-0 mb-4" separator=" "/>
        </xpath>

        <xpath expr="//div[@id='out_of_stock_buttons_wrapper']" position="after">
            <xpath expr="//div[@id='stock_notification_div_wrapper']" position="move"/>
        </xpath>
        <button id="product_stock_notification_message" position="attributes">
            <attribute
                name="t-attf-class"
                add="btn-lg {{('' if is_50_pc else ' px-xl-0')}}"
                separator=" "
            />
        </button>
         <button id="stock_notification_success_message" position="attributes">
            <attribute
                name="t-attf-class"
                add="btn-lg {{('' if is_50_pc else ' px-xl-0')}}"
                separator=" "
            />
        </button>
        <xpath expr="//div[@id='stock_notification_input_wrapper']" position="attributes">
            <attribute name="class" add="stock_notification_input_group input-group-lg" separator=" "/>
        </xpath>
    </template>

</odoo>
