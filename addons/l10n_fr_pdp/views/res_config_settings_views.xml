<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.proxy.user</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account_peppol.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='account_peppol']/div/div/field[@name='account_peppol_proxy_state']" position="replace">
                <span> </span>
                <field invisible="account_peppol_eas == '0225' and account_peppol_proxy_state == 'smp_registration'" name="account_peppol_proxy_state" class="oe_inline o_form_label text-lowercase" readonly="1"/>
                <span invisible="account_peppol_eas != '0225' or account_peppol_proxy_state != 'smp_registration'" class="o_form_label">is pending; you can not yet send or receive</span>
           </xpath>

            <xpath expr="//div[@id='account_peppol']" position="inside">
                <div id="l10n_fr_pdp_registered" class="col-12 o_setting_box"
                     invisible="account_peppol_eas != '0225' or account_peppol_proxy_state not in ('sender', 'receiver')">
                    <div class="o_setting_left_pane">
                        <field name="l10n_fr_pdp_send_to_ppf"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="l10n_fr_pdp_send_to_ppf"/>
                        <div class="text-muted">
                            Enable e-reporting &amp; sending of invoices to the PPF
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
