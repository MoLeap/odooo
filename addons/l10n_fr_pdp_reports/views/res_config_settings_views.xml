<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.proxy.user</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='account_peppol']" position="inside">

                <div id="l10n_fr_pdp_reports" class="col-12 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="l10n_fr_pdp_reports_enabled"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="l10n_fr_pdp_reports_enabled"/>
                        <div class="text-muted">
                            Activate Flux 10 e-reporting generation for this company.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
